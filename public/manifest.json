{
  "manifest_version": 3,
  "name": "NoChoice",
  "version": "0.1.0",
  "description": "Hides AliExpress listings marked with the Choice or Brand+ badge.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"],
  "content_scripts": [
    {
      "matches": ["*://*.aliexpress.com/*", "*://*.aliexpress.us/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "NoChoice",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nochoice@zygispr",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
