{
  // Tests, scripts, and tool configs. Imported src/ files are pulled in automatically.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node", "chrome", "vite/client", "@testing-library/jest-dom"]
  },
  "include": [
    "tests",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/vite-env.d.ts",
    "scripts",
    "*.config.ts"
  ]
}
